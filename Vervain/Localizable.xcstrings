        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca cachés, registros, archivos de idioma y descargas antiguas.\\nNada se elimina sin tu revisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez les caches, journaux, fichiers de langue et anciens téléchargements.\\nRien n'est supprimé sans votre accord."
