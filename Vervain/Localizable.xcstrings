    "Nothing is ever removed without a review screen. Risky or low-confidence items are never selected by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Prüfbildschirm wird nie etwas entfernt. Riskante oder unsichere Objekte sind nie vorausgewählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is ever removed without a review screen. Risky or low-confidence items are never selected by default."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca se elimina nada sin una pantalla de revisión. Los elementos arriesgados o de baja confianza nunca se preseleccionan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est jamais supprimé sans écran de vérification. Les éléments risqués ou peu fiables ne sont jamais présélectionnés."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnceleme ekranı olmadan hiçbir şey kaldırılmaz. Riskli veya düşük güvenli öğeler varsayılan olarak asla seçilmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有检查界面，绝不会删除任何内容。有风险或可信度低的项目默认绝不会被选中。"
          }
        }
      }
    },
