    "Put back %lld items. %lld could not be restored — check the Trash.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Objekte zurückgelegt. %lld konnten nicht wiederhergestellt werden – prüfen Sie den Papierkorb."
          }
        },
