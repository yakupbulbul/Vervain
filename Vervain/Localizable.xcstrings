      }
    },
    "Your startup disk is over 80% full. Cleaning system junk can free space.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Startfestplatte ist zu über 80 % voll. Das Bereinigen von Systemmüll kann Platz schaffen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your startup disk is over 80% full. Cleaning system junk can free space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu disco de arranque está más del 80% lleno. Limpiar basura del sistema puede liberar espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre disque de démarrage est rempli à plus de 80 %. Le nettoyage des fichiers système peut libérer de l'espace."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıç diskiniz %80'den fazla dolu. Sistem gereksizlerini temizlemek alan açabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动磁盘已超过 80%。清理系统垃圾可释放空间。"
          }
        }
      }
    },
    "Your startup disk is over 90% full. Review and remove cached files and old downloads.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Startfestplatte ist zu über 90 % voll. Überprüfen und entfernen Sie Cache-Dateien und alte Downloads."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your startup disk is over 90% full. Review and remove cached files and old downloads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu disco de arranque está más del 90% lleno. Revisa y elimina archivos en caché y descargas antiguas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre disque de démarrage est rempli à plus de 90 %. Examinez et supprimez les fichiers en cache et les anciens téléchargements."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıç diskiniz %90'dan fazla dolu. Önbellek dosyalarını ve eski indirmeleri gözden geçirip kaldırın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动磁盘已超过 90%。请检查并移除缓存文件和旧下载项。"
          }
        }
      }
    },
