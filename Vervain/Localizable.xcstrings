    "%lld system-protected folders couldn't be read. This is normal — macOS protects these with SIP.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld systemgeschützte Ordner konnten nicht gelesen werden. Das ist normal — macOS schützt diese mit SIP."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld system-protected folders couldn't be read. This is normal — macOS protects these with SIP."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld carpetas protegidas del sistema no se pudieron leer. Esto es normal — macOS las protege con SIP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dossiers protégés par le système n'ont pas pu être lus. C'est normal — macOS les protège avec SIP."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sistem korumalı klasör okunamadı. Bu normaldir — macOS bunları SIP ile korur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个系统保护文件夹无法读取。这是正常的——macOS 通过 SIP 保护这些文件夹。"
          }
        }
      }
    },
