        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önbellekleri, günlükleri, dil dosyalarını ve eski indirmeleri tarayın.\\nOnayınız olmadan hiçbir şey kaldırılmaz."
          }
        },
        "zh-Hans": {
