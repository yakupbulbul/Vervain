    "%@ is still running. Quitting it first avoids leaving files behind.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ läuft noch. Wenn Sie es zuerst beenden, bleiben keine Dateien zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is still running. Quitting it first avoids leaving files behind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sigue en ejecución. Cerrarlo antes evita dejar archivos huérfanos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est toujours en cours d'exécution. Le quitter d'abord évite de laisser des fichiers derrière."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hâlâ çalışıyor. Önce kapatmak, geride dosya kalmasını önler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 仍在运行。先退出可避免残留文件。"
          }
        }
      }
    },
