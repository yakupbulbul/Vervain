          "stringUnit": {
            "state": "translated",
            "value": "已放回 %lld 项。%lld 项无法恢复——请检查废纸篓。"
          }
        }
      }
    },
    "Put back %lld items. %lld could not be restored — they may no longer be in the Trash.": {
