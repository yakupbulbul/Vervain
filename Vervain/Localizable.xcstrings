    "Looks in your Library for preferences, caches and containers\nwhose app is no longer installed. Nothing is pre-selected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sucht in Ihrer Library nach Einstellungen, Caches und Containern,\nderen App nicht mehr installiert ist. Nichts ist vorausgewählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks in your Library for preferences, caches and containers\nwhose app is no longer installed. Nothing is pre-selected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca en tu Biblioteca preferencias, cachés y contenedores\ncuya app ya no está instalada. No hay nada preseleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cherche dans votre Bibliothèque les préférences, caches et conteneurs\ndont l'app n'est plus installée. Rien n'est présélectionné."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitaplığınızda, uygulaması artık yüklü olmayan tercihleri,\nönbellekleri ve kapsayıcıları arar. Hiçbir şey önceden seçili değildir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您的资源库中查找其应用已不再安装的偏好设置、\n缓存和容器。默认不选中任何项目。"
          }
        }
      }
    },
    "Looks through Downloads, Documents, Desktop, Movies, Music and Pictures.\nNothing is removed without your review.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsucht Downloads, Dokumente, Schreibtisch, Filme, Musik und Bilder.\nOhne Ihre Prüfung wird nichts entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks through Downloads, Documents, Desktop, Movies, Music and Pictures.\nNothing is removed without your review."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa Descargas, Documentos, Escritorio, Películas, Música e Imágenes.\nNo se elimina nada sin tu revisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcourt Téléchargements, Documents, Bureau, Films, Musique et Images.\nRien n'est supprimé sans votre vérification."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilenler, Belgeler, Masaüstü, Filmler, Müzik ve Resimler'e bakar.\nİncelemeniz olmadan hiçbir şey kaldırılmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看下载、文稿、桌面、影片、音乐和图片。\n未经您检查，不会移除任何内容。"
          }
        }
      }
    },
