    "%lld folders couldn't be read. Grant Full Disk Access for a complete picture.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Ordner konnten nicht gelesen werden. Gewähren Sie vollständigen Festplattenzugriff für ein vollständiges Bild."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld folders couldn't be read. Grant Full Disk Access for a complete picture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld carpetas no se pudieron leer. Concede Acceso completo al disco para una vista completa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dossiers n'ont pas pu être lus. Accordez l'accès complet au disque pour une vue complète."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld klasör okunamadı. Tam görünüm için Tam Disk Erişimi verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个文件夹无法读取。授予完全磁盘访问权限以获取完整信息。"
          }
        }
      }
    },
    "%lld folders were inaccessible — grant Full Disk Access for complete results.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Ordner waren nicht zugänglich — gewähren Sie vollständigen Festplattenzugriff für vollständige Ergebnisse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld folders were inaccessible — grant Full Disk Access for complete results."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld carpetas fueron inaccesibles — concede Acceso completo al disco para resultados completos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dossiers étaient inaccessibles — accordez l'accès complet au disque pour des résultats complets."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld klasöre erişilemedi — eksiksiz sonuçlar için Tam Disk Erişimi verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个文件夹无法访问——授予完全磁盘访问权限以获取完整结果。"
          }
        }
      }
    },
    "%lld issues found that affect your score.": {
      "localizations": {
