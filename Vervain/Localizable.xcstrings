    "Finds data left by Safari, Chrome, Firefox, Edge and Brave.\nOnly caches are pre-selected. History and cookies are your call.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Findet Daten von Safari, Chrome, Firefox, Edge und Brave.\nNur Caches sind vorausgewählt. Verlauf und Cookies entscheiden Sie selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds data left by Safari, Chrome, Firefox, Edge and Brave.\nOnly caches are pre-selected. History and cookies are your call."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra datos de Safari, Chrome, Firefox, Edge y Brave.\nSolo las cachés vienen preseleccionadas. El historial y las cookies los decides tú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve les données laissées par Safari, Chrome, Firefox, Edge et Brave.\nSeuls les caches sont présélectionnés. L'historique et les cookies, c'est à vous de décider."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari, Chrome, Firefox, Edge ve Brave'in bıraktığı verileri bulur.\nYalnızca önbellekler önceden seçilidir. Geçmiş ve çerezler size kalmış."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找 Safari、Chrome、Firefox、Edge 和 Brave 留下的数据。\n默认只选中缓存，历史记录和 Cookie 由您决定。"
          }
        }
      }
    },
