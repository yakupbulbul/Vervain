    "Scan for caches, logs, language files, and old downloads.\nNothing is removed without your review.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche nach Caches, Logs, Sprachdateien und alten Downloads.\nNichts wird ohne Ihre Bestätigung entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan for caches, logs, language files, and old downloads.\nNothing is removed without your review."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca cachés, registros, archivos de idioma y descargas antiguas.\nNada se elimina sin tu revisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez les caches, journaux, fichiers de langue et anciens téléchargements.\nRien n'est supprimé sans votre validation."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önbellekleri, günlükleri, dil dosyalarını ve eski indirmeleri tarayın.\nOnayınız olmadan hiçbir şey kaldırılmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描缓存、日志、语言文件和旧下载项。\n不经您审核，不会移除任何内容。"
          }
        }
      }
    },
    "Scan for caches, logs, language files, and old downloads.\\nNothing is removed without your review.": {
