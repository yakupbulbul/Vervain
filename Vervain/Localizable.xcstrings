    "Vervain": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain"
          }
        }
      }
    },
    "Vervain asks for Full Disk Access only so it can scan your protected folders. You can decline — partial results will still work.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain fragt den vollständigen Festplattenzugriff nur an, um Ihre geschützten Ordner scannen zu können. Sie können ablehnen – Teilergebnisse funktionieren trotzdem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain asks for Full Disk Access only so it can scan your protected folders. You can decline — partial results will still work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain solo pide acceso total al disco para poder escanear tus carpetas protegidas. Puedes rechazarlo: los resultados parciales seguirán funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain demande l'accès complet au disque uniquement pour analyser vos dossiers protégés. Vous pouvez refuser — les résultats partiels fonctionneront quand même."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain, Tam Disk Erişimi'ni yalnızca korumalı klasörlerinizi tarayabilmek için ister. Reddedebilirsiniz — kısmi sonuçlar yine de çalışır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain 只会为了扫描受保护的文件夹而请求完全磁盘访问权限。您可以拒绝——仍可获得部分结果。"
          }
        }
      }
    },
    "Vervain can send local notifications. They never leave your Mac, and you can change this later in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain kann lokale Mitteilungen senden. Sie verlassen Ihren Mac nie, und Sie können das später in den Einstellungen ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain can send local notifications. They never leave your Mac, and you can change this later in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain puede enviar notificaciones locales. Nunca salen de tu Mac y puedes cambiarlo más tarde en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain peut envoyer des notifications locales. Elles ne quittent jamais votre Mac et vous pouvez modifier cela plus tard dans les réglages."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain yerel bildirimler gönderebilir. Bunlar Mac'inizden asla çıkmaz ve bunu daha sonra Ayarlar'dan değiştirebilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain 可以发送本地通知。它们不会离开您的 Mac，您之后可以在设置中更改。"
          }
        }
      }
    },
    "Vervain moves files to Trash so nothing is permanently lost, but please confirm the items below before continuing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain verschiebt Dateien in den Papierkorb, damit nichts dauerhaft verloren geht. Bitte bestätigen Sie die folgenden Elemente, bevor Sie fortfahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain moves files to Trash so nothing is permanently lost, but please confirm the items below before continuing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain mueve archivos a la Papelera para que nada se pierda permanentemente, pero confirma los elementos a continuación antes de continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain déplace les fichiers dans la corbeille pour que rien ne soit définitivement perdu, mais veuillez confirmer les éléments ci-dessous avant de continuer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain dosyaları Çöp Sepeti'ne taşır, böylece kalıcı olarak kaybolmazlar. Devam etmeden önce aşağıdaki öğeleri onaylayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain 将文件移至废纸篓，不会永久删除。请在继续前确认以下项目。"
          }
        }
      }
    },
    "Vervain never offers files in these folders for cleanup. You can also drop folders here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain bietet Dateien in diesen Ordnern nie zur Bereinigung an. Sie können Ordner auch hierher ziehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain never offers files in these folders for cleanup. You can also drop folders here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain nunca ofrece archivos de estas carpetas para limpiar. También puedes soltar carpetas aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain ne propose jamais les fichiers de ces dossiers au nettoyage. Vous pouvez aussi y déposer des dossiers."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain bu klasörlerdeki dosyaları temizlik için asla önermez. Klasörleri buraya sürükleyip de bırakabilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain 绝不会把这些文件夹中的文件用于清理。您也可以把文件夹拖到这里。"
          }
        }
      }
    },
    "Vervain never sends data anywhere. No telemetry, no analytics, no account. Everything runs on this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain sendet nirgendwohin Daten. Keine Telemetrie, keine Analysen, kein Konto. Alles läuft auf diesem Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain never sends data anywhere. No telemetry, no analytics, no account. Everything runs on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain nunca envía datos a ningún sitio. Sin telemetría, sin analíticas, sin cuenta. Todo se ejecuta en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain n'envoie jamais de données. Pas de télémétrie, pas d'analyses, pas de compte. Tout s'exécute sur ce Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain hiçbir yere veri göndermez. Telemetri yok, analiz yok, hesap yok. Her şey bu Mac'te çalışır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain 不会向任何地方发送数据。没有遥测、没有分析、没有账户。一切都在这台 Mac 上运行。"
          }
        }
      }
    },
    "Vervain only contacts the network when you press this button.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain greift nur auf das Netzwerk zu, wenn Sie diese Taste drücken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain only contacts the network when you press this button."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain solo se conecta a la red cuando pulsas este botón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain ne se connecte au réseau que lorsque vous appuyez sur ce bouton."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain yalnızca bu düğmeye bastığınızda ağa bağlanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有当您按下此按钮时，Vervain 才会访问网络。"
          }
        }
      }
    },
    "Vervain runs entirely on your Mac. Granting access lets it scan protected folders too.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain läuft vollständig auf Ihrem Mac. Durch Zugriff können auch geschützte Ordner gescannt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain runs entirely on your Mac. Granting access lets it scan protected folders too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain funciona completamente en tu Mac. Conceder acceso permite analizar carpetas protegidas también."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain fonctionne entièrement sur votre Mac. Accorder l'accès permet aussi d'analyser les dossiers protégés."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain tamamen Mac'inizde çalışır. Erişim izni vererek korunan klasörleri de tarayabilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain 完全在本地运行。授予权限后还可扫描受保护的文件夹。"
          }
        }
      }
    },
    "Vervain scans your caches, logs, language files,\napps, and disk usage — and explains every finding.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain scannt Ihre Caches, Logs, Sprachdateien,\nApps und Speichernutzung — und erklärt jeden Fund."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain scans your caches, logs, language files,\napps, and disk usage — and explains every finding."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain analiza cachés, registros, archivos de idioma,\naplicaciones y uso de disco — y explica cada hallazgo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain analyse vos caches, journaux, fichiers de langue,\napplications et utilisation du disque — et explique chaque résultat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain önbellekleri, günlükleri, dil dosyalarını,\nuygulamaları ve disk kullanımını tarar — her bulguyu açıklar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain 扫描缓存、日志、语言文件、\n应用和磁盘使用情况——并详细解释每项发现。"
          }
        }
      }
    },
    "Vervain scans your caches, logs, language files,\\napps, and disk usage — and explains every finding.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain scannt Caches, Logs, Sprachdateien,\\nApps und Speichernutzung — und erklärt jeden Fund."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain scans your caches, logs, language files,\\napps, and disk usage — and explains every finding."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain analiza cachés, registros, archivos de idioma,\\naplicaciones y uso de disco — y explica cada hallazgo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain analyse vos caches, journaux, fichiers de langue,\\napplications et espace disque — et explique chaque résultat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain önbelleklerinizi, günlüklerinizi, dil dosyalarınızı,\\nuygulamalarınızı ve disk kullanımınızı tarar — ve her bulguyu açıklar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain 扫描缓存、日志、语言文件、\\n应用和磁盘使用情况——并详细解释每项发现。"
          }
        }
      }
    },
