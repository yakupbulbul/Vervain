    "This space is used by macOS system data — APFS snapshots, virtual memory, firmware, and other protected resources that can't be individually listed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Speicher wird von macOS-Systemdaten verwendet — APFS-Snapshots, virtueller Speicher, Firmware und andere geschützte Ressourcen, die nicht einzeln aufgelistet werden können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This space is used by macOS system data — APFS snapshots, virtual memory, firmware, and other protected resources that can't be individually listed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este espacio es usado por datos del sistema macOS — instantáneas APFS, memoria virtual, firmware y otros recursos protegidos que no pueden listarse individualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet espace est utilisé par les données système macOS — instantanés APFS, mémoire virtuelle, firmware et autres ressources protégées non détaillables."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alan macOS sistem verileri tarafından kullanılıyor — APFS anlık görüntüler, sanal bellek, donanım yazılımı ve tek tek listelenemeyen diğer korunan kaynaklar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此空间由 macOS 系统数据占用——APFS 快照、虚拟内存、固件和其他无法单独列出的受保护资源。"
          }
        }
      }
    },
