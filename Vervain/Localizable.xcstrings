    "Find installed apps with confidence-graded leftover\ndetection. Apple system apps are protected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkennt installierte Apps und deren Rückstände\nmit Zuverlässigkeitsbewertung. Apple-System-Apps sind geschützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find installed apps with confidence-graded leftover\ndetection. Apple system apps are protected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra apps instaladas con detección de residuos\npor nivel de confianza. Las apps del sistema Apple están protegidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez les apps installées avec détection de résidus\npar niveau de confiance. Les apps système Apple sont protégées."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güven dereceli kalıntı tespiti ile yüklü uygulamaları\nbulun. Apple sistem uygulamaları korunur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找已安装应用并进行置信度分级的残留\n检测。Apple 系统应用受到保护。"
          }
        }
      }
    },
