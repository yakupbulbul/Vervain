    "Every cleanup moves files to the Trash. You can restore anything until you empty it yourself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Bereinigung legt Dateien in den Papierkorb. Sie können alles wiederherstellen, bis Sie ihn selbst leeren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every cleanup moves files to the Trash. You can restore anything until you empty it yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada limpieza mueve los archivos a la Papelera. Puedes restaurar cualquier cosa hasta que la vacíes tú mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque nettoyage place les fichiers dans la corbeille. Vous pouvez tout restaurer tant que vous ne l'avez pas vidée."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her temizlik dosyaları Çöp Sepeti'ne taşır. Siz boşaltana kadar her şeyi geri alabilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次清理都会把文件移到废纸篓。在您清空废纸篓之前，都可以恢复。"
          }
        }
      }
    },
    "Every item in your Library belongs to an installed app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Objekt in Ihrer Library gehört zu einer installierten App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every item in your Library belongs to an installed app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los elementos de tu Biblioteca pertenecen a una app instalada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les éléments de votre Bibliothèque appartiennent à une app installée."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitaplığınızdaki her öğe yüklü bir uygulamaya ait."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资源库中的每一项都属于已安装的应用。"
          }
        }
      }
    },
    "Everything Vervain moved to the Trash": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was Vervain in den Papierkorb gelegt hat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything Vervain moved to the Trash"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que Vervain movió a la Papelera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que Vervain a placé dans la corbeille"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain'in Çöp Sepeti'ne taşıdığı her şey"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervain 移到废纸篓的所有内容"
          }
        }
      }
    },
    "Exact match — very likely correct": {
      "localizations": {
        "de": {
