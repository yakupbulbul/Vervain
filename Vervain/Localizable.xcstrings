    "You have %lld applications installed. Removing unused ones can free space and reduce background activity.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben %lld Anwendungen installiert. Das Entfernen ungenutzter Apps kann Platz schaffen und Hintergrundaktivität reduzieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have %lld applications installed. Removing unused ones can free space and reduce background activity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes %lld aplicaciones instaladas. Eliminar las que no usas puede liberar espacio y reducir la actividad en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez %lld applications installées. Supprimer celles inutilisées peut libérer de l'espace et réduire l'activité en arrière-plan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld uygulamanız yüklü. Kullanılmayanları kaldırmak alan açabilir ve arka plan etkinliğini azaltabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装 %lld 个应用。移除不用的可以释放空间并减少后台活动。"
          }
        }
      }
    },
